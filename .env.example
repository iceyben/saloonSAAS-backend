# ── Database ──────────────────────────────────────────────
DATABASE_URL="file:./salon.db"

# ── Server ────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173   # React dev server

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_here
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Africa's Talking (SMS) ────────────────────────────────
# Use "sandbox" as username + any key for free testing
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=                      # leave blank for sandbox

# ── Salon info (used in SMS messages) ────────────────────
SALON_NAME="Glam Studio"
SALON_PHONE="+250700000000"        # WhatsApp/call number
